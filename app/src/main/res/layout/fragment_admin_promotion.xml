<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F5F5">

    <LinearLayout
        android:id="@+id/layoutAdminPromotionHeader"
        android:layout_width="match_parent"
        android:layout_height="96dp"
        android:background="@drawable/bg_primary"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="20dp"
        android:paddingTop="16dp"
        android:paddingEnd="20dp"
        android:paddingBottom="14dp">

        <TextView
            android:id="@+id/tvAdminPromotionTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="@string/admin_promotion_title"
            android:textColor="@color/white"
            android:textSize="24sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:gravity="end"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/btnAdminPromotionCreate"
                android:layout_width="70dp"
                android:layout_height="38dp"
                android:background="@drawable/bg_admin_header_action"
                android:gravity="center"
                android:text="@string/admin_promotion_add_short"
                android:textColor="@color/primary_dark"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/btnAdminPromotionRefresh"
                android:layout_width="78dp"
                android:layout_height="38dp"
                android:layout_marginStart="8dp"
                android:background="@drawable/bg_admin_header_action"
                android:gravity="center"
                android:text="@string/admin_promotion_refresh"
                android:textColor="@color/primary_dark"
                android:textSize="14sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>

    <ProgressBar
        android:id="@+id/progressAdminPromotions"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="4dp"
        android:layout_below="@id/layoutAdminPromotionHeader"
        android:indeterminate="true"
        android:visibility="gone" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvAdminPromotions"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/layoutAdminPromotionHeader"
        android:clipToPadding="false"
        android:paddingStart="12dp"
        android:paddingTop="12dp"
        android:paddingEnd="12dp"
        android:paddingBottom="18dp"
        android:visibility="gone" />

    <TextView
        android:id="@+id/tvAdminPromotionEmpty"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/layoutAdminPromotionHeader"
        android:gravity="center"
        android:padding="24dp"
        android:text="@string/admin_promotion_empty"
        android:textColor="@color/text_hint"
        android:textSize="16sp"
        android:visibility="gone" />
</RelativeLayout>
