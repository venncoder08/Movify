<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal"
    android:background="#FFFFFF"
    android:paddingTop="8dp"
    android:paddingBottom="8dp"
    android:weightSum="5">

    <LinearLayout
        android:id="@+id/tabProfile"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:gravity="center"
        android:orientation="vertical"
        android:clickable="true"
        android:focusable="true">

        <ImageView
            android:id="@+id/iconProfile"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:src="@drawable/ic_user" />

        <TextView
            android:id="@+id/tvProfile"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/nav_profile"
            android:textSize="13sp"
            android:textColor="#222222" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/tabNotification"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:gravity="center"
        android:orientation="vertical"
        android:clickable="true"
        android:focusable="true">

        <FrameLayout
            android:layout_width="30dp"
            android:layout_height="24dp">

            <ImageView
                android:id="@+id/iconNotification"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_noti" />

            <View
                android:id="@+id/dotNotificationUnread"
                android:layout_width="9dp"
                android:layout_height="9dp"
                android:layout_gravity="top|end"
                android:layout_marginTop="1dp"
                android:layout_marginEnd="2dp"
                android:background="@drawable/bg_badge_red"
                android:visibility="gone" />
        </FrameLayout>

        <TextView
            android:id="@+id/tvNotification"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/nav_notification"
            android:textSize="13sp"
            android:textColor="#222222" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/tabBooking"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:gravity="center"
        android:orientation="vertical"
        android:clickable="true"
        android:focusable="true">

        <ImageView
            android:id="@+id/iconBooking"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:src="@drawable/ic_logo" />

        <TextView
            android:id="@+id/tvBooking"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/nav_booking"
            android:textSize="13sp"
            android:textColor="#222222" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/tabHistory"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:gravity="center"
        android:orientation="vertical"
        android:clickable="true"
        android:focusable="true">

        <ImageView
            android:id="@+id/iconHistory"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:src="@drawable/ic_history" />

        <TextView
            android:id="@+id/tvHistory"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/nav_history"
            android:textSize="13sp"
            android:textColor="#222222" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/tabMessage"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:gravity="center"
        android:orientation="vertical"
        android:clickable="true"
        android:focusable="true">

        <FrameLayout
            android:layout_width="30dp"
            android:layout_height="24dp">

            <ImageView
                android:id="@+id/iconMessage"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_message" />

            <View
                android:id="@+id/dotMessageUnread"
                android:layout_width="9dp"
                android:layout_height="9dp"
                android:layout_gravity="top|end"
                android:layout_marginTop="1dp"
                android:layout_marginEnd="2dp"
                android:background="@drawable/bg_badge_red"
                android:visibility="gone" />
        </FrameLayout>

        <TextView
            android:id="@+id/tvMessage"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/nav_message"
            android:textSize="13sp"
            android:textColor="#222222" />
    </LinearLayout>

</LinearLayout>
