<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
	xmlns:app="http://schemas.android.com/apk/res-auto"
	android:layout_width="match_parent"
	android:layout_height="match_parent"
	android:background="@color/white"
	android:orientation="vertical">

	<RelativeLayout
		android:layout_width="match_parent"
		android:layout_height="96dp"
		android:background="@drawable/bg_primary"
		android:paddingStart="20dp"
		android:paddingTop="20dp"
		android:paddingEnd="20dp"
		android:paddingBottom="20dp">

		<ImageView
			android:id="@+id/ivBack"
			android:layout_width="44dp"
			android:layout_height="44dp"
			android:layout_centerVertical="true"
			android:background="@drawable/bg_input"
			android:padding="12dp"
			android:rotation="180"
			android:src="@drawable/ic_arrow"
			app:tint="@color/primary" />

		<TextView
			android:layout_width="wrap_content"
			android:layout_height="wrap_content"
			android:layout_centerInParent="true"
			android:text="@string/edit_profile_title"
			android:textColor="@color/white"
			android:textSize="22sp"
			android:textStyle="bold" />
	</RelativeLayout>

	<ScrollView
		android:layout_width="match_parent"
		android:layout_height="match_parent"
		android:fillViewport="true">

		<LinearLayout
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:orientation="vertical"
			android:padding="20dp">

			<LinearLayout
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:background="@drawable/bg_card_large"
				android:elevation="3dp"
				android:orientation="vertical"
				android:padding="20dp">

				<LinearLayout
					android:layout_width="match_parent"
					android:layout_height="wrap_content"
					android:gravity="center_vertical"
					android:orientation="horizontal">

					<FrameLayout
						android:layout_width="72dp"
						android:layout_height="72dp"
						android:background="@drawable/bg_icon_blue_soft">

						<ImageView
							android:id="@+id/ivAvatar"
							android:layout_width="32dp"
							android:layout_height="32dp"
							android:layout_gravity="center"
							android:scaleType="centerInside"
							android:src="@drawable/ic_user"
							app:tint="@color/white" />
					</FrameLayout>

					<LinearLayout
						android:layout_width="0dp"
						android:layout_height="wrap_content"
						android:layout_marginStart="16dp"
						android:layout_weight="1"
						android:orientation="vertical">

						<TextView
							android:layout_width="wrap_content"
							android:layout_height="wrap_content"
							android:text="@string/edit_profile_title"
							android:textColor="@color/text_secondary"
							android:textSize="18sp"
							android:textStyle="bold" />

						<TextView
							android:layout_width="wrap_content"
							android:layout_height="wrap_content"
							android:layout_marginTop="6dp"
							android:text="@string/edit_profile_desc"
							android:textColor="@color/text_hint"
							android:textSize="14sp" />
					</LinearLayout>
				</LinearLayout>

				<View
					android:layout_width="match_parent"
					android:layout_height="1dp"
					android:layout_marginTop="20dp"
					android:layout_marginBottom="20dp"
					android:background="@color/gray" />

				<TextView
					android:layout_width="wrap_content"
					android:layout_height="wrap_content"
					android:text="@string/full_name_label"
					android:textColor="@color/text_hint"
					android:textSize="14sp" />

				<EditText
					android:id="@+id/etFullName"
					android:layout_width="match_parent"
					android:layout_height="wrap_content"
					android:layout_marginTop="6dp"
					android:background="@drawable/bg_input"
					android:hint="@string/full_name_hint"
					android:inputType="textPersonName"
					android:padding="14dp"
					android:textColor="@color/text_secondary"
					android:textColorHint="@color/text_hint" />

				<TextView
					android:layout_width="wrap_content"
					android:layout_height="wrap_content"
					android:layout_marginTop="18dp"
					android:text="@string/phone_number_label"
					android:textColor="@color/text_hint"
					android:textSize="14sp" />

				<EditText
					android:id="@+id/etPhoneNumber"
					android:layout_width="match_parent"
					android:layout_height="wrap_content"
					android:layout_marginTop="6dp"
					android:background="@drawable/bg_input"
					android:hint="@string/phone_number_hint"
					android:inputType="phone"
					android:padding="14dp"
					android:textColor="@color/text_secondary"
					android:textColorHint="@color/text_hint" />

				<TextView
					android:layout_width="wrap_content"
					android:layout_height="wrap_content"
					android:layout_marginTop="18dp"
					android:text="@string/gender_label"
					android:textColor="@color/text_hint"
					android:textSize="14sp" />

				<Spinner
					android:id="@+id/spinnerGender"
					android:layout_width="match_parent"
					android:layout_height="wrap_content"
					android:layout_marginTop="6dp"
					android:background="@drawable/bg_input"
					android:padding="10dp" />

				<TextView
					android:layout_width="wrap_content"
					android:layout_height="wrap_content"
					android:layout_marginTop="18dp"
					android:text="@string/date_of_birth_label"
					android:textColor="@color/text_hint"
					android:textSize="14sp" />

				<TextView
					android:id="@+id/tvDateOfBirth"
					android:layout_width="match_parent"
					android:layout_height="wrap_content"
					android:layout_marginTop="6dp"
					android:background="@drawable/bg_input"
					android:padding="14dp"
					android:text="@string/profile_select_date_hint"
					android:textColor="@color/text_secondary"
					android:textSize="16sp" />

				<TextView
					android:id="@+id/btnPickDate"
					android:layout_width="wrap_content"
					android:layout_height="48dp"
					android:layout_marginTop="12dp"
					android:background="@drawable/bg_button"
					android:gravity="center"
					android:minWidth="170dp"
					android:paddingStart="24dp"
					android:paddingEnd="24dp"
					android:text="@string/pick_date"
					android:textColor="@color/white"
					android:textSize="16sp"
					android:textStyle="bold" />

				<TextView
					android:layout_width="wrap_content"
					android:layout_height="wrap_content"
					android:layout_marginTop="18dp"
					android:text="@string/avatar_label"
					android:textColor="@color/text_hint"
					android:textSize="14sp" />

				<TextView
					android:id="@+id/btnChangeAvatar"
					android:layout_width="wrap_content"
					android:layout_height="48dp"
					android:layout_marginTop="6dp"
					android:background="@drawable/bg_input"
					android:gravity="center"
					android:minWidth="170dp"
					android:paddingStart="24dp"
					android:paddingEnd="24dp"
					android:text="@string/change_avatar"
					android:textColor="@color/primary"
					android:textSize="16sp"
					android:textStyle="bold" />

				<TextView
					android:id="@+id/btnSave"
					android:layout_width="match_parent"
					android:layout_height="48dp"
					android:layout_marginTop="24dp"
					android:background="@drawable/bg_button"
					android:gravity="center"
					android:paddingStart="24dp"
					android:paddingEnd="24dp"
					android:text="@string/save_changes"
					android:textColor="@color/white"
					android:textSize="16sp"
					android:textStyle="bold" />

				<TextView
					android:id="@+id/btnCancel"
					android:layout_width="match_parent"
					android:layout_height="48dp"
					android:layout_marginTop="12dp"
					android:background="@drawable/bg_input"
					android:gravity="center"
					android:paddingStart="24dp"
					android:paddingEnd="24dp"
					android:text="@string/cancel"
					android:textColor="@color/text_secondary"
					android:textSize="16sp"
					android:textStyle="bold" />
			</LinearLayout>
		</LinearLayout>
	</ScrollView>
</LinearLayout>
