<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    android:background="@drawable/bg_admin_request_card"
    android:elevation="2dp"
    android:orientation="vertical"
    android:padding="14dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/ivDriverAvatar"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@drawable/bg_notification_icon"
            android:contentDescription="@string/admin_driver_request_avatar"
            android:padding="9dp"
            android:scaleType="centerCrop"
            android:src="@drawable/ic_user" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvDriverName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="@color/text_secondary"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvDriverMeta"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="@color/text_hint"
                android:textSize="13sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvRequestStatus"
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:background="@drawable/bg_input"
            android:gravity="center"
            android:minWidth="86dp"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:textColor="@color/primary"
            android:textSize="12sp"
            android:textStyle="bold" />
    </LinearLayout>

    <TextView
        android:id="@+id/tvRequestDate"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:textColor="@color/text_hint"
        android:textSize="13sp" />

    <TextView
            android:id="@+id/tvVehicleType"
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_notification_icon"
            android:gravity="center"
            android:minWidth="96dp"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:textColor="@color/primary_dark"
            android:textSize="13sp"
            android:textStyle="bold" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/admin_driver_request_id_card_title"
                android:textColor="@color/text_hint"
                android:textSize="12sp" />

            <ImageView
                android:id="@+id/ivIdCardImage"
                android:layout_width="match_parent"
                android:layout_height="88dp"
                android:layout_marginTop="5dp"
                android:background="@drawable/bg_input"
                android:contentDescription="@string/admin_driver_request_id_card_title"
                android:padding="8dp"
                android:scaleType="centerCrop"
                android:src="@drawable/ic_card" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/admin_driver_request_license_title"
                android:textColor="@color/text_hint"
                android:textSize="12sp" />

            <ImageView
                android:id="@+id/ivDriverLicenseImage"
                android:layout_width="match_parent"
                android:layout_height="88dp"
                android:layout_marginTop="5dp"
                android:background="@drawable/bg_input"
                android:contentDescription="@string/admin_driver_request_license_title"
                android:padding="8dp"
                android:scaleType="centerCrop"
                android:src="@drawable/ic_card" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/admin_driver_request_registration_title"
                android:textColor="@color/text_hint"
                android:textSize="12sp" />

            <ImageView
                android:id="@+id/ivVehicleRegistrationImage"
                android:layout_width="match_parent"
                android:layout_height="88dp"
                android:layout_marginTop="5dp"
                android:background="@drawable/bg_input"
                android:contentDescription="@string/admin_driver_request_registration_title"
                android:padding="8dp"
                android:scaleType="centerCrop"
                android:src="@drawable/ic_card" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/actionsContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:gravity="end"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/btnRejectRequest"
            android:layout_width="108dp"
            android:layout_height="42dp"
            android:background="@drawable/bg_admin_action_danger"
            android:gravity="center"
            android:text="@string/admin_request_reject"
            android:textColor="#D64545"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/btnApproveRequest"
            android:layout_width="108dp"
            android:layout_height="42dp"
            android:layout_marginStart="10dp"
            android:background="@drawable/bg_admin_action_primary"
            android:gravity="center"
            android:text="@string/admin_request_approve"
            android:textColor="@color/white"
            android:textSize="14sp"
            android:textStyle="bold" />
    </LinearLayout>
</LinearLayout>
