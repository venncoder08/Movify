<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F5F5">

    <LinearLayout
        android:id="@+id/layoutAdminRequestHeader"
        android:layout_width="match_parent"
        android:layout_height="132dp"
        android:background="@drawable/bg_primary"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="20dp"
        android:paddingTop="28dp"
        android:paddingEnd="20dp"
        android:paddingBottom="18dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvAdminRequestTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/admin_driver_request_title"
                android:textColor="@color/white"
                android:textSize="26sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvAdminRequestSubtitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:maxLines="2"
                android:text="@string/admin_driver_request_subtitle"
                android:textColor="#EAF2FF"
                android:textSize="14sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/btnAdminRequestRefresh"
            android:layout_width="92dp"
            android:layout_height="40dp"
            android:layout_marginStart="12dp"
            android:background="@drawable/bg_input"
            android:gravity="center"
            android:text="@string/admin_driver_request_refresh"
            android:textColor="@color/primary_dark"
            android:textSize="14sp"
            android:textStyle="bold" />
    </LinearLayout>

    <ProgressBar
        android:id="@+id/progressAdminRequests"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="4dp"
        android:layout_below="@id/layoutAdminRequestHeader"
        android:indeterminate="true"
        android:visibility="gone" />

    <TextView
        android:id="@+id/tvAdminRequestEmpty"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/layoutAdminRequestHeader"
        android:gravity="center"
        android:padding="24dp"
        android:text="@string/admin_driver_request_empty"
        android:textColor="@color/text_hint"
        android:textSize="16sp"
        android:visibility="gone" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvAdminDriverRequests"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/layoutAdminRequestHeader"
        android:clipToPadding="false"
        android:paddingStart="12dp"
        android:paddingTop="12dp"
        android:paddingEnd="12dp"
        android:paddingBottom="18dp" />
</RelativeLayout>
