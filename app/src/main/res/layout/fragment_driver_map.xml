<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white">

    <!-- Map Container -->
    <FrameLayout
        android:id="@+id/mapDriverContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <!-- Google Map Fragment -->
        <fragment
            android:id="@+id/mapDriver"
            android:name="com.google.android.gms.maps.SupportMapFragment"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />
    </FrameLayout>

    <!-- Bottom Sheet Panel for Nearby Trips -->
    <LinearLayout
        android:id="@+id/bottomSheetPanel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:background="@drawable/bg_card_large"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Header: Refresh Button -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/nearby_trips"
                android:textColor="@color/text_primary"
                android:textSize="16sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btnRefreshTrips"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:background="@drawable/bg_button_small"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:text="@string/refresh"
                android:textColor="@color/white"
                android:textSize="12sp" />
        </LinearLayout>

        <!-- Trips List -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/tripsRecyclerView"
            android:layout_width="match_parent"
            android:layout_height="200dp"
            android:layout_marginTop="12dp"
            android:nestedScrollingEnabled="false" />

        <!-- Empty State -->
        <TextView
            android:id="@+id/emptyTripsText"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:text="@string/no_nearby_trips"
            android:textColor="@color/text_hint"
            android:textSize="14sp"
            android:visibility="gone" />

        <!-- Accept Trip Button -->
        <Button
            android:id="@+id/btnAcceptTrip"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_button"
            android:text="@string/accept_trip"
            android:textColor="@color/white"
            android:textSize="14sp"
            android:textStyle="bold"
            android:enabled="false" />

        <TextView
            android:id="@+id/btnCancelTrip"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_admin_action_danger"
            android:text="@string/cancel_trip"
            android:textColor="#D64545"
            android:textSize="14sp"
            android:textStyle="bold"
            android:gravity="center"
            android:visibility="gone" />

        <TextView
            android:id="@+id/btnMessageTrip"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_button_small"
            android:gravity="center"
            android:text="@string/message_open_passenger"
            android:textColor="@color/white"
            android:textSize="14sp"
            android:textStyle="bold"
            android:visibility="gone" />
    </LinearLayout>

    <!-- Loading Progress Bar -->
    <ProgressBar
        android:id="@+id/loadingProgressBar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:visibility="gone" />
</FrameLayout>
