{
  "name": "movify-backend",
  "version": "1.0.0",
  "private": true,
  "description": "Basic Node.js backend for Movify mobile services",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node src/server.js",
    "db:generate": "prisma generate --schema db/schema.prisma",
    "db:migrate": "prisma migrate dev --schema db/schema.prisma",
    "db:seed": "node db/seed.js",
    "db:push": "prisma db push --schema db/schema.prisma",
    "db:pull": "prisma db pull --schema db/schema.prisma",
    "db:studio": "prisma studio --schema db/schema.prisma",
    "db:validate": "prisma validate --schema db/schema.prisma"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@prisma/client": "^6.18.0",
    "dotenv": "^16.6.1",
    "express": "^5.1.0"
  },
  "devDependencies": {
    "prisma": "^6.18.0"
  }
}
