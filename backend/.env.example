PORT=3000
DATABASE_URL="postgresql://postgres.lcgfsarxcrvhhwqqdogb:[YOUR-PASSWORD]@aws-1-ap-southeast-1.pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.lcgfsarxcrvhhwqqdogb:[YOUR-PASSWORD]@aws-1-ap-southeast-1.pooler.supabase.com:5432/postgres"
GEOAPIFY_API_KEY=[YOUR-GEOAPIFY-API-KEY]
GEOAPIFY_COUNTRYCODE=vn
GEOAPIFY_BIAS=proximity:106.6297,10.8231
GEOAPIFY_AUTOCOMPLETE_LIMIT=5
GOOGLE_CLIENT_ID=[YOUR-WEB-CLIENT-ID.apps.googleusercontent.com]

# JWT Configuration
JWT_SECRET=[YOUR-SECRET-KEY-MIN-32-CHARS]
JWT_EXPIRATION=7d

# Email Configuration (for OTP)
# Gmail: Use app password (not regular password)
# Recommended: Use Gmail App Password for security
EMAIL_SERVICE=gmail
EMAIL_USER=[YOUR-EMAIL@gmail.com]
EMAIL_PASSWORD=[YOUR-APP-PASSWORD]
EMAIL_FROM=[YOUR-EMAIL@gmail.com]

# OTP Configuration
OTP_EXPIRATION=600  # 10 minutes in seconds
OTP_LENGTH=6        # 6-digit OTP

# Cloudinary Configuration (for avatar/image upload)
# Use these when uploading profile images to Cloudinary
CLOUDINARY_CLOUD_NAME=[YOUR-CLOUDINARY-CLOUD-NAME]
CLOUDINARY_API_KEY=[YOUR-CLOUDINARY-API-KEY]
CLOUDINARY_API_SECRET=[YOUR-CLOUDINARY-API-SECRET]
CLOUDINARY_UPLOAD_PRESET=[YOUR-UNSIGNED-UPLOAD-PRESET]
CLOUDINARY_FOLDER=movify
