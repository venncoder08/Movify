generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum AccountRole {
  User
  Driver
  Admin
}

enum Gender {
  Male
  Female
  Other
}

enum DriverApprovalStatus {
  Pending
  Approved
  Rejected
}

enum TripType {
  Motor
  Taxi
}

enum TripStatus {
  Pending
  Accepted
  InProgress
  Completed
  Cancelled
}

enum PaymentMethod {
  Cash
  BankTransfer
}

enum PaymentStatus {
  Unpaid
  Paid
}

enum ToDriverRequestStatus {
  Pending
  Approved
  Rejected
}

model Account {
  id                  Int                    @id @default(autoincrement()) @map("ID")
  email               String                 @unique(map: "Account_Email_key") @db.VarChar(255) @map("Email")
  phoneNumber         String                 @unique(map: "Account_PhoneNumber_key") @db.VarChar(20) @map("PhoneNumber")
  hashedPassword      String                 @db.VarChar(255) @map("HashedPassword")
  role                AccountRole           @map("Role")
  fullName            String?                @db.VarChar(255) @map("FullName")
  dateOfBirth         DateTime?              @db.Date @map("DateOfBirth")
  gender              Gender?                @map("Gender")
  avatar              String?                @db.VarChar(500) @map("Avatar")
  isActive            Boolean                @default(true) @map("IsActive")
  idCard              String?                @db.VarChar(50) @map("IDCard")
  driverLicense       String?                @db.VarChar(50) @map("DriverLicense")
  vehicleRegistration String?                @db.VarChar(100) @map("VehicleRegistration")
  driverStatus        DriverApprovalStatus?  @map("DriverStatus")
  ratePoint           Decimal                @default(0) @db.Decimal(3, 2) @map("RatePoint")
  createdAt           DateTime               @default(now()) @db.Timestamptz(6) @map("CreatedAt")
  updatedAt           DateTime               @updatedAt @db.Timestamptz(6) @map("UpdatedAt")
  deletedAt           DateTime?              @db.Timestamptz(6) @map("DeletedAt")
  promotionsAsAdmin   Promotion[]            @relation("PromotionAdmin")
  tripsAsUser         Trip[]                 @relation("TripUser")
  tripsAsDriver       Trip[]                 @relation("TripDriver")
  ratingsGiven        Rating[]               @relation("RatingRater")
  ratingsReceived     Rating[]               @relation("RatingRatee")
  notifications       Notification[]
  driverRequests      ToDriverRequest[]      @relation("DriverRequestOwner")
  reviewedRequests    ToDriverRequest[]      @relation("DriverRequestReviewer")

  @@index([role], map: "idx_account_role")
  @@index([isActive], map: "idx_account_active")
  @@index([deletedAt], map: "idx_account_deleted")
  @@map("Account")
}

model Promotion {
  id            Int       @id @default(autoincrement()) @map("ID")
  name          String    @db.VarChar(255) @map("Name")
  type          String    @db.VarChar(100) @map("Type")
  discountValue Decimal   @db.Decimal(10, 2) @map("DiscountValue")
  adminId       Int       @map("AdminID")
  createdAt     DateTime  @default(now()) @db.Timestamptz(6) @map("CreatedAt")
  updatedAt     DateTime  @updatedAt @db.Timestamptz(6) @map("UpdatedAt")
  deletedAt     DateTime? @db.Timestamptz(6) @map("DeletedAt")
  admin         Account   @relation("PromotionAdmin", fields: [adminId], references: [id], onDelete: Restrict)
  trips         Trip[]

  @@index([adminId], map: "idx_promotion_admin")
  @@index([deletedAt], map: "idx_promotion_deleted")
  @@map("Promotion")
}

model Trip {
  id                  Int            @id @default(autoincrement()) @map("ID")
  distance            Decimal        @db.Decimal(10, 2) @map("Distance")
  totalAmount         Decimal        @db.Decimal(12, 2) @map("TotalAmount")
  pickUpLocation      String         @db.VarChar(500) @map("PickUpLocation")
  destinationLocation String         @db.VarChar(500) @map("DestinationLocation")
  duration            Decimal?       @db.Decimal(10, 2) @map("Duration")
  tripType            TripType       @default(Motor) @map("TripType")
  status              TripStatus     @default(Pending) @map("Status")
  pickUpTime          DateTime?      @db.Timestamptz(6) @map("PickUpTime")
  completedTime       DateTime?      @db.Timestamptz(6) @map("CompletedTime")
  cancelReason        String?        @db.Text @map("CancelReason")
  paymentMethod       PaymentMethod  @default(Cash) @map("PaymentMethod")
  paymentStatus       PaymentStatus  @default(Unpaid) @map("PaymentStatus")
  userId              Int            @map("UserID")
  driverId            Int?           @map("DriverID")
  promotionId         Int?           @map("PromotionID")
  createdAt           DateTime       @default(now()) @db.Timestamptz(6) @map("CreatedAt")
  updatedAt           DateTime       @updatedAt @db.Timestamptz(6) @map("UpdatedAt")
  deletedAt           DateTime?      @db.Timestamptz(6) @map("DeletedAt")
  user                Account        @relation("TripUser", fields: [userId], references: [id], onDelete: Restrict)
  driver              Account?       @relation("TripDriver", fields: [driverId], references: [id], onDelete: SetNull)
  promotion           Promotion?     @relation(fields: [promotionId], references: [id], onDelete: SetNull)
  ratings             Rating[]

  @@index([userId], map: "idx_trip_user")
  @@index([driverId], map: "idx_trip_driver")
  @@index([promotionId], map: "idx_trip_promotion")
  @@index([tripType], map: "idx_trip_type")
  @@index([status], map: "idx_trip_status")
  @@index([paymentStatus], map: "idx_trip_payment_status")
  @@index([deletedAt], map: "idx_trip_deleted")
  @@map("Trip")
}

model Rating {
  id        Int       @id @default(autoincrement()) @map("ID")
  tripId    Int       @map("TripID")
  raterId   Int       @map("RaterID")
  rateeId   Int       @map("RateeID")
  score     Decimal   @db.Decimal(2, 1) @map("Score")
  comment   String?   @db.Text @map("Comment")
  createdAt DateTime  @default(now()) @db.Timestamptz(6) @map("CreatedAt")
  updatedAt DateTime  @updatedAt @db.Timestamptz(6) @map("UpdatedAt")
  deletedAt DateTime? @db.Timestamptz(6) @map("DeletedAt")
  trip      Trip      @relation(fields: [tripId], references: [id], onDelete: Cascade)
  rater     Account   @relation("RatingRater", fields: [raterId], references: [id], onDelete: Cascade)
  ratee     Account   @relation("RatingRatee", fields: [rateeId], references: [id], onDelete: Cascade)

  @@unique([tripId, raterId], map: "Rating_TripID_RaterID_key")
  @@index([tripId], map: "idx_rating_trip")
  @@index([rateeId], map: "idx_rating_ratee")
  @@index([deletedAt], map: "idx_rating_deleted")
  @@map("Rating")
}

model Notification {
  id        Int       @id @default(autoincrement()) @map("ID")
  accountId Int       @map("AccountID")
  title     String    @db.VarChar(255) @map("Title")
  body      String    @db.Text @map("Body")
  isRead    Boolean   @default(false) @map("IsRead")
  createdAt DateTime  @default(now()) @db.Timestamptz(6) @map("CreatedAt")
  updatedAt DateTime  @updatedAt @db.Timestamptz(6) @map("UpdatedAt")
  deletedAt DateTime? @db.Timestamptz(6) @map("DeletedAt")
  account   Account   @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([accountId], map: "idx_notification_account")
  @@index([isRead], map: "idx_notification_read")
  @@index([deletedAt], map: "idx_notification_deleted")
  @@map("Notification")
}

model ToDriverRequest {
  id                  Int                    @id @default(autoincrement()) @map("ID")
  idCard              String                 @db.VarChar(50) @map("IDCard")
  driverLicense       String                 @db.VarChar(50) @map("DriverLicense")
  vehicleRegistration String                 @db.VarChar(100) @map("VehicleRegistration")
  status              ToDriverRequestStatus  @default(Pending) @map("Status")
  driverId            Int                    @map("DriverID")
  adminId             Int?                   @map("AdminID")
  createdAt           DateTime               @default(now()) @db.Timestamptz(6) @map("CreatedAt")
  updatedAt           DateTime               @updatedAt @db.Timestamptz(6) @map("UpdatedAt")
  deletedAt           DateTime?              @db.Timestamptz(6) @map("DeletedAt")
  driver              Account                @relation("DriverRequestOwner", fields: [driverId], references: [id], onDelete: Cascade)
  admin               Account?               @relation("DriverRequestReviewer", fields: [adminId], references: [id], onDelete: SetNull)

  @@index([driverId], map: "idx_todriverrequest_driver")
  @@index([adminId], map: "idx_todriverrequest_admin")
  @@index([status], map: "idx_todriverrequest_status")
  @@index([deletedAt], map: "idx_todriverrequest_deleted")
  @@map("ToDriverRequest")
}
